  {
    "name": "yaml-merge-override-and-null-volume",
    "text": "x-defaults: &defaults\n  image: nginx:alpine\n  labels:\n    keep: yes\nservices:\n  web:\n    <<: *defaults\n    image: nginx:stable\n    command: [sh, -c, \"echo $$HOME\"]\nvolumes:\n  data:\n",
    "language": "yaml",
    "manifest": {},
    "services": {
      "web": {
        "image": "nginx:stable",
        "labels": {
          "keep": "yes"
        },
        "command": ["sh", "-c", "echo $$HOME"]
      }
    },
    "volumes": {
      "data": {}
    },
    "compose": {
      "x-defaults": {
        "image": "nginx:alpine",
        "labels": {
          "keep": "yes"
        }
      }
    }
  },
  {
    "name": "yaml-multidoc-and-whole-core-millicpu",
    "text": "{\"apiVersion\": \"v1\", \"kind\": \"ConfigMap\", \"metadata\": {\"name\": \"settings\"}, \"data\": {\"mode\": \"demo\"}}\n---\n{\"apiVersion\": \"v1\", \"kind\": \"Pod\", \"metadata\": {\"name\": \"worker\"}, \"spec\": {\"restartPolicy\": \"Never\", \"containers\": [{\"name\": \"app\", \"image\": \"busybox\", \"resources\": {\"limits\": {\"cpu\": \"10000m\", \"memory\": \"1Mi\"}}}]}}",
    "language": "yaml",
    "manifest": {},
    "services": {
      "worker": {
        "image": "busybox",
        "deploy": {
          "resources": {
            "limits": {
              "cpus": "10",
              "memory": "1048576"
            }
          }
        }
      }
    },
    "volumes": {},
    "native": [
      {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
          "name": "settings"
        },
        "data": {
          "mode": "demo"
        }
      },
      {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {
          "name": "worker"
        },
        "spec": {
          "restartPolicy": "Never",
          "containers": [
            {
              "name": "app",
              "image": "busybox",
              "resources": {
                "limits": {
                  "cpu": "10000m",
                  "memory": "1Mi"
                }
              }
            }
          ]
        }
      }
    ]
  },
  {
    "name": "native-node-port-service",
    "manifest": [
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "web",
          "namespace": "demo"
        },
        "spec": {
          "selector": {
            "matchLabels": {
              "app": "web"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "app": "web"
              }
            },
            "spec": {
              "containers": [
                {
                  "name": "app",
                  "image": "nginx",
                  "ports": [
                    {
                      "name": "http",
                      "containerPort": 80
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {
          "name": "public-web",
          "namespace": "demo",
          "annotations": {
            "example.com/provider": "keep"
          }
        },
        "spec": {
          "type": "NodePort",
          "selector": {
            "app": "web"
          },
          "ports": [
            {
              "name": "http",
              "port": 8080,
              "targetPort": "http",
              "nodePort": 30080,
              "appProtocol": "http"
            }
          ]
        }
      }
    ],
    "native": [
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "web",
          "namespace": "demo"
        },
        "spec": {
          "selector": {
            "matchLabels": {
              "app": "web"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "app": "web"
              }
            },
            "spec": {
              "containers": [
                {
                  "name": "app",
                  "image": "nginx",
                  "ports": [
                    {
                      "name": "http",
                      "containerPort": 80
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {
          "name": "public-web",
          "namespace": "demo",
          "annotations": {
            "example.com/provider": "keep"
          }
        },
        "spec": {
          "type": "NodePort",
          "selector": {
            "app": "web"
          },
          "ports": [
            {
              "name": "http",
              "port": 8080,
              "targetPort": "http",
              "nodePort": 30080,
              "appProtocol": "http"
            }
          ]
        }
      }
    ],
    "services": {
      "web": {
        "image": "nginx",
        "expose": ["80"]
      }
    },
    "volumes": {},
    "networking": {
      "web": {
        "service": {
          "type": "NodePort",
          "ports": [
            {
              "name": "http",
              "port": 8080,
              "targetPort": "http",
              "protocol": "TCP",
              "nodePort": 30080,
              "appProtocol": "http"
            }
          ]
        },
        "native": true
      }
    }
  }
]
